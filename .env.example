# AI Body Coach — environment variables
# Sumber: docs/02-technical-spec.md §2.
#
# FILE INI IKUT TER-COMMIT. Isinya hanya placeholder — jangan pernah menaruh
# nilai asli di sini. Nilai asli masuk ke .env.local, yang di-gitignore.

# ---- Database (Supabase / Postgres) ----
# DATABASE_URL  = connection pooler (port 6543, pakai ?pgbouncer=true) — dipakai aplikasi
# DIRECT_URL    = koneksi langsung (port 5432) — dipakai migration
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# ---- Redis (Upstash) ----
REDIS_URL=
REDIS_TOKEN=

# ---- WhatsApp Cloud API (Meta) ----
WA_PHONE_NUMBER_ID=
WA_BUSINESS_ACCOUNT_ID=
WA_ACCESS_TOKEN=
WA_WEBHOOK_VERIFY_TOKEN=
WA_APP_SECRET=                # untuk verifikasi X-Hub-Signature-256
WA_BUSINESS_NUMBER=           # format E.164 untuk deep link wa.me

# ---- AI ----
AI_COACH_MODEL=
AI_VISION_MODEL=
AI_EMBEDDING_MODEL=
AI_PROVIDER_KEY=
AI_DAILY_COST_CAP_IDR=15000   # cap global harian, kill switch

# ---- Pembayaran ----
PAYMENT_PROVIDER=xendit
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_TOKEN=

# ---- Lain-lain ----
STORAGE_BUCKET=
APP_URL=http://localhost:3000
SENTRY_DSN=
POSTHOG_KEY=
